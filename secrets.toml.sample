# .streamlit/secrets.toml
#
# Sign-in accounts. This sample works as-is so you can test today:
#   overseer  / Gathering2026!
#   assistant / Assistant2026!
# Replace both hashes before anyone else uses the app — these passwords are
# written down right here, which makes them useless as passwords.
#
# Make your own:  python3 make_password.py
#
# Keys must be lowercase. role must be exactly "Overseer" or "Assistant Overseer".
# password_hash is bcrypt. Older password_sha256 entries still work, but the
# app treats them as legacy — replace them when you can.

[users.overseer]
password_hash = "$2b$12$KlpQxgWzTEEhQhG5kCQSXeJjhH.1FQ.4BWyWrFLLhzq.xLc34Oa.C"
role = "Overseer"

[users.assistant]
password_hash = "$2b$12$KD5NDWeP1.fmITa1OHiXruLRw63aHSTyWx9oDACLyzm4PX.I13eX6"
role = "Assistant Overseer"


# ---------------------------------------------------------------------------
# Neon Postgres. Leave this block out and the app uses SQLite in data/portal.db.
# Copy the pooled connection string from the Neon dashboard, and create a role
# for the app rather than using the owner account.
# ---------------------------------------------------------------------------

# [postgres]
# dsn = "postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/gathering?sslmode=require"


# ---------------------------------------------------------------------------
# Google Sheets mirror, for the Push to Sheets button only. Create a service
# account, paste its JSON key fields below, then share the spreadsheet with
# the client_email address as an Editor.
# ---------------------------------------------------------------------------

# [sheets]
# spreadsheet_id = "1AbC...the long id from the sheet URL"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "gathering-portal@your-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
